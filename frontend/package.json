{
  "name": "shopzone-storefront",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/unit.test.mjs",
    "test:smoke": "node --test tests/http-smoke.test.mjs",
    "test:contract": "node tests/backend-contract.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.56.0"
  }
}
